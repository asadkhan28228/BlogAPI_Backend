
@{
    var isLoggedIn = Context.Session.GetString("AccessToken") != null;
    var userRole = Context.Session.GetString("Role");
    var isAdmin = string.Equals(
        userRole,
        "Admin",
        StringComparison.OrdinalIgnoreCase
    );
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Blog API
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Blog_Frontend.styles.css"
          asp-append-version="true" />

    <style>

            /* ==========================================================
               GLOBAL
               ========================================================== */

            :root {
                --primary: #6366f1;
                --primary-dark: #4f46e5;
                --dark: #0f172a;
                --dark-soft: #111827;
                --text-muted: #94a3b8;
                --border-dark: rgba(255,255,255,.10);
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                background: #f8fafc;
                color: #1e293b;
                min-height: 100vh;
            }

            main {
                min-height: calc(100vh - 180px);
            }


            /* ==========================================================
               NAVBAR
               ========================================================== */

            .main-navbar {
                background:
                    linear-gradient(
                        135deg,
                        #0f172a 0%,
                        #111827 50%,
                        #1e1b4b 100%
                    ) !important;

                border-bottom: 1px solid rgba(255,255,255,.08);
                box-shadow: 0 8px 30px rgba(15,23,42,.18);
                padding: 14px 0;
            }

            .navbar-brand {
                display: flex;
                align-items: center;
                gap: 10px;

                font-size: 1.35rem;
                letter-spacing: -.3px;

                color: #ffffff !important;
            }

            .brand-icon {
                width: 40px;
                height: 40px;

                display: inline-flex;
                align-items: center;
                justify-content: center;

                border-radius: 12px;

                background:
                    linear-gradient(
                        135deg,
                        var(--primary),
                        #8b5cf6
                    );

                box-shadow:
                    0 8px 20px rgba(99,102,241,.35);

                font-size: 1.15rem;
            }

            .brand-text {
                display: flex;
                flex-direction: column;
                line-height: 1.05;
            }

            .brand-title {
                font-weight: 800;
            }

            .brand-subtitle {
                font-size: .65rem;
                font-weight: 500;
                color: #94a3b8;
                letter-spacing: 1px;
                text-transform: uppercase;
                margin-top: 4px;
            }


            /* ==========================================================
               NAVIGATION LINKS
               ========================================================== */

            .main-navbar .nav-link {
                position: relative;

                color: #cbd5e1 !important;

                font-size: .94rem;
                font-weight: 500;

                padding: 9px 13px !important;

                border-radius: 9px;

                transition:
                    background .2s ease,
                    color .2s ease,
                    transform .2s ease;
            }

            .main-navbar .nav-link:hover {
                color: #ffffff !important;

                background: rgba(255,255,255,.08);

                transform: translateY(-1px);
            }

            .main-navbar .nav-link i {
                font-size: .95rem;
            }


            /* ==========================================================
               ADMIN BUTTON
               ========================================================== */

            .admin-nav-link {
                color: #fbbf24 !important;
                background: rgba(245,158,11,.08);
                border: 1px solid rgba(245,158,11,.15);
            }

            .admin-nav-link:hover {
                color: #fcd34d !important;
                background: rgba(245,158,11,.16) !important;
            }


            /* ==========================================================
               CREATE POST BUTTON
               ========================================================== */

            .create-post-link {
                color: #ffffff !important;

                background:
                    linear-gradient(
                        135deg,
                        var(--primary),
                        var(--primary-dark)
                    );

                box-shadow:
                    0 5px 15px rgba(99,102,241,.25);
            }

            .create-post-link:hover {
                color: #ffffff !important;

                background:
                    linear-gradient(
                        135deg,
                        #818cf8,
                        #6366f1
                    ) !important;

                box-shadow:
                    0 8px 20px rgba(99,102,241,.35);
            }


            /* ==========================================================
               AUTH BUTTONS
               ========================================================== */

            .login-link {
                margin-left: 6px;
            }

            .register-btn {
                margin-left: 8px;

                border: none;

                color: #ffffff !important;

                background:
                    linear-gradient(
                        135deg,
                        var(--primary),
                        #8b5cf6
                    );

                border-radius: 10px;

                font-weight: 600;

                box-shadow:
                    0 6px 18px rgba(99,102,241,.28);

                transition: all .2s ease;
            }

            .register-btn:hover {
                color: #ffffff !important;

                transform: translateY(-1px);

                box-shadow:
                    0 10px 24px rgba(99,102,241,.38);
            }


            /* ==========================================================
               LOGOUT
               ========================================================== */

            .logout-btn {
                color: #fca5a5 !important;

                border: 1px solid rgba(248,113,113,.12);

                border-radius: 9px;

                padding: 8px 13px !important;

                text-decoration: none;

                transition: all .2s ease;
            }

            .logout-btn:hover {
                color: #fecaca !important;

                background: rgba(239,68,68,.10);

                border-color: rgba(248,113,113,.25);
            }


            /* ==========================================================
               MOBILE NAVBAR
               ========================================================== */

            .navbar-toggler {
                border: 1px solid rgba(255,255,255,.15);

                padding: 8px 10px;

                border-radius: 9px;
            }

            .navbar-toggler:focus {
                box-shadow:
                    0 0 0 3px rgba(99,102,241,.25);
            }

            @@media(max-width: 991px) {

                .main-navbar {
                    padding: 11px 0;
                }

                .navbar-collapse {
                    margin-top: 15px;

                    padding: 12px;

                    border-radius: 14px;

                    background: rgba(15,23,42,.96);

                    border: 1px solid rgba(255,255,255,.08);
                }

                .main-navbar .nav-link {
                    margin-bottom: 3px;
                }

                .login-link,
                .register-btn {
                    margin-left: 0;
                    margin-top: 5px;
                }

                .register-btn {
                    display: inline-block;
                    width: fit-content;
                }
            }


            /* ==========================================================
               CONTENT
               ========================================================== */

            .page-container {
                padding-top: 30px;
                padding-bottom: 40px;
            }


            /* ==========================================================
               ALERTS
               ========================================================== */

            .modern-alert {
                border: none;

                border-radius: 14px;

                padding: 14px 18px;

                box-shadow:
                    0 5px 20px rgba(15,23,42,.06);
            }

            .modern-alert.alert-success {
                background: #ecfdf5;
                color: #065f46;
            }

            .modern-alert.alert-danger {
                background: #fef2f2;
                color: #991b1b;
            }

            .modern-alert .btn-close {
                font-size: .75rem;
            }


            /* ==========================================================
               FOOTER
               ========================================================== */

            .main-footer {
                position: relative;

                background:
                    linear-gradient(
                        135deg,
                        #0f172a,
                        #111827,
                        #1e1b4b
                    );

                color: #cbd5e1;

                margin-top: 50px;

                border-top:
                    1px solid rgba(255,255,255,.06);
            }

            .footer-brand {
                display: flex;
                align-items: center;
                gap: 10px;

                color: #ffffff;

                font-size: 1.1rem;
                font-weight: 800;
            }

            .footer-brand-icon {
                width: 34px;
                height: 34px;

                display: inline-flex;
                align-items: center;
                justify-content: center;

                border-radius: 10px;

                background:
                    linear-gradient(
                        135deg,
                        var(--primary),
                        #8b5cf6
                    );
            }

            .main-footer h6 {
                color: #ffffff;

                font-weight: 700;

                margin-bottom: 18px;
            }

            .footer-description {
                color: #94a3b8;

                line-height: 1.7;

                max-width: 430px;
            }

            .footer-links {
                list-style: none;

                padding: 0;
                margin: 0;
            }

            .footer-links li {
                margin-bottom: 10px;
            }

            .footer-links a {
                color: #94a3b8 !important;

                text-decoration: none;

                transition:
                    color .2s ease,
                    padding-left .2s ease;
            }

            .footer-links a:hover {
                color: #ffffff !important;

                padding-left: 4px;
            }

            .footer-account-btn {
                background: none;
                border: none;

                color: #94a3b8;

                padding: 0;

                transition: color .2s ease;
            }

            .footer-account-btn:hover {
                color: #ffffff;
            }

            .footer-divider {
                border-color: rgba(255,255,255,.08);
            }

            .footer-copy {
                color: #64748b;
            }


            /* ==========================================================
               SCROLLBAR
               ========================================================== */

            ::-webkit-scrollbar {
                width: 8px;
            }

            ::-webkit-scrollbar-track {
                background: #f1f5f9;
            }

            ::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 10px;
            }

            ::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }

    </style>

</head>


<body>

    <!-- ==========================================================
         NAVBAR
         ========================================================== -->

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark main-navbar">

            <div class="container">

                <!-- Brand -->

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">
                        <i class="bi bi-journal-richtext"></i>
                    </span>

                    <span class="brand-text">

                        <span class="brand-title">
                            Blogs
                        </span>

                        <span class="brand-subtitle">
                            Modern Publishing
                        </span>

                    </span>

                </a>


                <!-- Mobile Toggle -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- Navbar -->

                <div class="collapse navbar-collapse"
                     id="mainNavbar">


                    <!-- LEFT MENU -->

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">

                        <!-- Home -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door me-1"></i>
                                Home

                            </a>

                        </li>


                        <!-- Posts -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Posts"
                               asp-action="Index">

                                <i class="bi bi-file-text me-1"></i>
                                Posts

                            </a>

                        </li>


                        <!-- Categories -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Categories"
                               asp-action="Index">

                                <i class="bi bi-grid me-1"></i>
                                Categories

                            </a>

                        </li>


                        <!-- Tags -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Tags"
                               asp-action="Index">

                                <i class="bi bi-tags me-1"></i>
                                Tags

                            </a>

                        </li>

                    </ul>


                    <!-- RIGHT MENU -->

                    <ul class="navbar-nav align-items-lg-center">

                        @if (isLoggedIn)
                        {

                            <!-- Create Post -->

                            <li class="nav-item">

                                <a class="nav-link create-post-link"
                                   asp-controller="Posts"
                                   asp-action="Create">

                                    <i class="bi bi-plus-lg me-1"></i>
                                    Create Post

                                </a>

                            </li>


                            @if (isAdmin)
                            {

                                <!-- Admin Dashboard -->

                                <li class="nav-item ms-lg-2">

                                    <a class="nav-link admin-nav-link"
                                       asp-controller="Admin"
                                       asp-action="Dashboard">

                                        <i class="bi bi-speedometer2 me-1"></i>
                                        Admin Dashboard

                                    </a>

                                </li>

                            }


                            <!-- Logout -->

                            <li class="nav-item ms-lg-2">

                                <form asp-controller="Auth"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="nav-link logout-btn">

                                        <i class="bi bi-box-arrow-right me-1"></i>
                                        Logout

                                    </button>

                                </form>

                            </li>

                        }
                        else
                        {

                            <!-- Login -->

                            <li class="nav-item">

                                <a class="nav-link login-link"
                                   asp-controller="Auth"
                                   asp-action="Login">

                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Login

                                </a>

                            </li>


                            <!-- Register -->

                            <li class="nav-item">

                                <a class="btn register-btn px-3"
                                   asp-controller="Auth"
                                   asp-action="Register">

                                    <i class="bi bi-person-plus me-1"></i>
                                    Register

                                </a>

                            </li>

                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- ==========================================================
         MAIN CONTENT
         ========================================================== -->

    <main>

        <div class="container page-container">


            <!-- Success -->
            @if (TempData["Success"] != null)
            {

                <div class="alert alert-success modern-alert alert-dismissible fade show"
                     role="alert">

                    <i class="bi bi-check-circle-fill me-2"></i>

                    <strong>Success:</strong>

                    @TempData["Success"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close">
                    </button>

                </div>

            }


            <!-- Error -->
            @if (TempData["Error"] != null)
            {

                <div class="alert alert-danger modern-alert alert-dismissible fade show"
                     role="alert">

                    <i class="bi bi-exclamation-triangle-fill me-2"></i>

                    <strong>Error:</strong>

                    @TempData["Error"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close">
                    </button>

                </div>

            }


            @RenderBody()

        </div>

    </main>


    <!-- ==========================================================
         FOOTER
         ========================================================== -->

    <footer class="main-footer">

        <div class="container py-5">

            <div class="row g-4">


                <!-- About -->

                <div class="col-lg-6 col-md-6">

                    <div class="footer-brand mb-3">

                        <span class="footer-brand-icon">
                            <i class="bi bi-journal-richtext"></i>
                        </span>

                        Blog API

                    </div>

                    <p class="footer-description mb-0">

                        A modern blog management system built with
                        ASP.NET Core MVC and Web API, designed for
                        creating, managing and sharing quality content.

                    </p>

                </div>


                <!-- Quick Links -->

                <div class="col-lg-3 col-md-3">

                    <h6>
                        Quick Links
                    </h6>

                    <ul class="footer-links">

                        <li>

                            <a asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-chevron-right me-1"></i>
                                Home

                            </a>

                        </li>

                        <li>

                            <a asp-controller="Posts"
                               asp-action="Index">

                                <i class="bi bi-chevron-right me-1"></i>
                                Posts

                            </a>

                        </li>

                        <li>

                            <a asp-controller="Categories"
                               asp-action="Index">

                                <i class="bi bi-chevron-right me-1"></i>
                                Categories

                            </a>

                        </li>

                        <li>

                            <a asp-controller="Tags"
                               asp-action="Index">

                                <i class="bi bi-chevron-right me-1"></i>
                                Tags

                            </a>

                        </li>

                    </ul>

                </div>


                <!-- Account -->

                <div class="col-lg-3 col-md-3">

                    <h6>
                        Account
                    </h6>

                    <ul class="footer-links">

                        @if (isLoggedIn)
                        {

                            <li>

                                <form asp-controller="Auth"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="footer-account-btn">

                                        <i class="bi bi-box-arrow-right me-1"></i>
                                        Logout

                                    </button>

                                </form>

                            </li>

                            @if (isAdmin)
                            {

                                <li>

                                    <a asp-controller="Admin"
                                       asp-action="Dashboard">

                                        <i class="bi bi-speedometer2 me-1"></i>
                                        Admin Dashboard

                                    </a>

                                </li>

                            }

                        }
                        else
                        {

                            <li>

                                <a asp-controller="Auth"
                                   asp-action="Login">

                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Login

                                </a>

                            </li>

                            <li>

                                <a asp-controller="Auth"
                                   asp-action="Register">

                                    <i class="bi bi-person-plus me-1"></i>
                                    Register

                                </a>

                            </li>

                        }

                    </ul>

                </div>

            </div>


            <hr class="footer-divider my-4" />


            <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-center
                gap-2">

                <small class="footer-copy">

                    &copy; @DateTime.Now.Year Blog API.
                    All rights reserved.

                </small>

                <small class="footer-copy">

                    Built with
                    <i class="bi bi-heart-fill text-danger"></i>
                    ASP.NET Core

                </small>

            </div>

        </div>

    </footer>


    <!-- ==========================================================
         SCRIPTS
         ========================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>
