@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="mb-4">

    <h1 class="fw-bold">
        Admin Dashboard
    </h1>

    <p class="text-muted">
        Manage your blog platform.
    </p>

</div>

<div class="row g-4">

    <div class="col-md-6 col-lg-3">

        <a asp-controller="Admin"
           asp-action="Users"
           class="text-decoration-none">

            <div class="dashboard-card">

                <i class="bi bi-people-fill"></i>

                <h4>
                    Users
                </h4>

                <p>
                    Manage users and roles.
                </p>

            </div>

        </a>

    </div>

    <div class="col-md-6 col-lg-3">

        <a asp-controller="Categories"
           asp-action="Index"
           class="text-decoration-none">

            <div class="dashboard-card">

                <i class="bi bi-folder-fill"></i>

                <h4>
                    Categories
                </h4>

                <p>
                    Manage blog categories.
                </p>

            </div>

        </a>

    </div>

    <div class="col-md-6 col-lg-3">

        <a asp-controller="Tags"
           asp-action="Index"
           class="text-decoration-none">

            <div class="dashboard-card">

                <i class="bi bi-tags-fill"></i>

                <h4>
                    Tags
                </h4>

                <p>
                    Manage blog tags.
                </p>

            </div>

        </a>

    </div>

    <div class="col-md-6 col-lg-3">

        <a asp-controller="Posts"
           asp-action="Index"
           class="text-decoration-none">

            <div class="dashboard-card">

                <i class="bi bi-file-earmark-text-fill"></i>

                <h4>
                    Posts
                </h4>

                <p>
                    View all blog posts.
                </p>

            </div>

        </a>

    </div>

</div>