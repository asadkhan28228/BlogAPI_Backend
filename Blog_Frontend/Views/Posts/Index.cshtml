@model BlogMVC.Models.Posts.PostPagedResultViewModel

@using BlogMVC.Models.Categories

@{
    ViewData["Title"] = "Posts";

    var categories =
        ViewBag.Categories as List<CategoryViewModel>
        ?? new List<CategoryViewModel>();

    string? keyword = ViewBag.Keyword;
    int? selectedCategory = ViewBag.CategoryId;
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h1 class="fw-bold mb-1">
            Explore Posts
        </h1>

        <p class="text-muted mb-0">
            Discover stories and ideas from our community.
        </p>

    </div>

    @if (Context.Session.GetString("AccessToken") != null)
    {
        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg"></i>
            Create Post

        </a>
    }

</div>

<form asp-action="Index"
      method="get"
      class="card border-0 shadow-sm p-3 mb-4">

    <div class="row g-3">

        <div class="col-md-6">

            <input type="text"
                   name="keyword"
                   value="@keyword"
                   class="form-control"
                   placeholder="Search posts..." />

        </div>

        <div class="col-md-4">

            <select name="categoryId"
                    class="form-select">

                <option value="">
                    All Categories
                </option>

                @foreach (var category in categories)
                {
                    <option value="@category.Id"
                            selected="@(selectedCategory == category.Id)">

                        @category.Name

                    </option>
                }

            </select>

        </div>

        <div class="col-md-2">

            <button type="submit"
                    class="btn btn-primary w-100">

                <i class="bi bi-search"></i>
                Search

            </button>

        </div>

    </div>

</form>

<div class="row g-4">

    @foreach (var post in Model.Items)
    {
        <div class="col-md-6 col-lg-4">

            <div class="card post-card h-100">

                <div class="card-body d-flex flex-column">

                    <div class="mb-2">

                        @if (post.Category != null)
                        {
                            <span class="badge bg-light text-primary">

                                @post.Category.Name

                            </span>
                        }

                    </div>

                    <h4 class="fw-bold">
                        @post.Title
                    </h4>

                    <p class="text-muted">

                        @(post.Content.Length > 150
                            ? post.Content.Substring(0, 150) + "..."
                            : post.Content)

                    </p>

                    <div class="small text-muted mt-auto mb-3">

                        <i class="bi bi-person"></i>

                        @(post.Author?.Username ?? "Unknown")

                        <span class="mx-2">•</span>

                        @post.CreatedAt.ToString("MMM dd, yyyy")

                    </div>

                    <a asp-action="Details"
                       asp-route-id="@post.Id"
                       class="btn btn-outline-primary">

                        Read Article

                    </a>

                </div>

            </div>

        </div>
    }

</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-5">

        <ul class="pagination justify-content-center">

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-keyword="@keyword"
                       asp-route-categoryId="@selectedCategory">

                        @i

                    </a>

                </li>
            }

        </ul>

    </nav>
}